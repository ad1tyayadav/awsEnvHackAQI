# =====================================================================
#  Clean Air Telegram bot - environment example
#
#  Copy this file to `.env` and fill in the three values below.
#
#      cp .env.example .env
#
#  IMPORTANT - nothing loads this file automatically. There is no dotenv
#  in the project. It is (a) a safe place to keep values out of git and
#  (b) the source for the deploy command:
#
#      set -a; source .env; set +a
#      cd backend && sam build && sam deploy --parameter-overrides \
#        OpenAQApiKey="$OPENAQ_API_KEY" \
#        TelegramBotToken="$TELEGRAM_BOT_TOKEN" \
#        TelegramWebhookSecret="$TELEGRAM_WEBHOOK_SECRET"
#
#  Tests and `scripts/preview-bot.ts` need NO values at all - they run
#  fully offline, which is why the suite is green with an empty .env.
#
#  NEVER put AWS access keys in this file. The AWS CLI and the AWS SDK
#  use `aws configure` / `aws sso login`. `.env` is gitignored; this
#  example file is not, so do not paste real secrets into it.
# =====================================================================


# --- 1. OpenAQ v3 API key --------------------------------------------
#    Where: https://explore.openaq.org/register  (free)
#    Used by: the 30-minute scheduler, to read the nearest PM2.5 station
#    SAM parameter: OpenAQApiKey  (NoEcho - never printed in deploy logs)
OPENAQ_API_KEY=


# --- 2. Telegram bot token -------------------------------------------
#    Where: message @BotFather -> /newbot -> copy the token
#    Format: 123456789:AA... (keep the whole thing, including the colon)
#    Used by: every reply and every alert the bot sends
#    SAM parameter: TelegramBotToken  (NoEcho)
TELEGRAM_BOT_TOKEN=


# --- 3. Telegram webhook secret --------------------------------------
#    Where: you generate it ->  openssl rand -hex 32
#    Rules: 1-256 characters, only A-Z a-z 0-9 _ and -
#    It must be THE SAME value in two places:
#      a) this file / the SAM parameter, which the Lambda compares against
#      b) the `secret_token` field of the setWebhook call (README, Deploy step 4)
#    Get it wrong and Telegram's requests are rejected with 403.
#    SAM parameter: TelegramWebhookSecret  (NoEcho)
TELEGRAM_WEBHOOK_SECRET=


# =====================================================================
#  Set automatically by template.yaml - do NOT fill these in.
#  Listed (commented, with their real values) so nothing looks missing
#  if you grep the code for environment variables.
#
#  Together with the three values above, these are the ONLY environment
#  variables the code reads today.
# =====================================================================
#STAGE=prod
#SUBSCRIBERS_TABLE=cleanair-subscribers-prod


# =====================================================================
#  AI answers in chat - NOT BUILT YET (planned as Phase 11).
#
#  No code reads these. Setting them today changes nothing at all, and
#  the deploy does not accept them yet. They are here so the values are
#  ready and the intended shape is recorded (README, Future scope).
#
#  Planned use: free-text questions in the chat ("is it safe to run?")
#  get a short answer from a Hugging Face model, grounded in the same
#  approved rule text as the alerts. Rules decide, AI only explains.
#
#  Tokens: ordered fallback list, comma-separated, no spaces. When one
#  runs out of credit the next is tried; with all of them exhausted the
#  bot replies with the rule-based answer instead of failing.
#  Model: chosen when that phase is built, never hard-coded.
#         Small instruct models (Qwen2.5-class, Llama-3.2-3B-instruct).
# =====================================================================
#HF_TOKENS=hf_tokenForAccountOne,hf_tokenForAccountTwo
#HF_MODEL=
